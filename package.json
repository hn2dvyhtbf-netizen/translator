{
  "name": "face-to-face-translator",
  "version": "1.0.0",
  "description": "iPhone 面對面雙向語音即時翻譯 App",
  "main": "index.html",
  "scripts": {
    "start": "python start_server.py",
    "build:web": "node scripts/build-web.js",
    "cap:add": "npx cap add ios",
